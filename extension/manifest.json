{
  "manifest_version": 3,
  "name": "Webstral",
  "version": "0.5.1",
  "description": "Discutez avec les modèles Mistral depuis n'importe quel onglet, avec suivi de consommation de tokens.",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "webstral@cabon14.com",
      "strict_min_version": "127.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Webstral",
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "Webstral",
    "default_panel": "sidepanel/sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "open_at_install": true
  },
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.mistral.ai/*",
    "https://admin.mistral.ai/*",
    "https://console.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["i18n.js", "background/background.js"]
  }
}
