{
  "manifest_version": 3,
  "name": "Netstral",
  "version": "1.0",
  "description": "Discutez avec les modèles Mistral depuis n'importe quel onglet, avec suivi de consommation de tokens.",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "netstral@cabon14.com",
      "strict_min_version": "127.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Netstral",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://admin.mistral.ai/*",
    "https://console.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["i18n.js", "background/background.js"]
  }
}
